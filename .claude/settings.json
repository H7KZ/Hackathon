{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "npm_config_manage_package_manager_versions": "false"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": ["~/Library/pnpm", "~/Library/Caches/pnpm"],
      "denyRead": [
        "**/.env",
        "**/.env.local",
        "**/.env.*.local",
        "**/.env.development",
        "**/.env.production",
        "**/.env.test"
      ]
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-verify.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
