      "id": "e1",
      "storyPointId": "sp1",
      "description": "Denní počet výpadků u routerů NetVlna Box 5G vzroste nejméně čtyřnásobně",
      "sql": "WITH periods(period) AS (VALUES ('before'), ('after')), x AS (SELECT CASE WHEN d < DATE '2026-06-15' THEN 'before' ELSE 'after' END AS period, COUNT(*) / COUNT(DISTINCT d) AS value FROM (SELECT start_date AS d FROM main.outage WHERE router_model = 'NetVlna Box 5G') WHERE (d BETWEEN DATE '2026-03-02' AND DATE '2026-06-14' OR d BETWEEN DATE '2026-06-22' AND DATE '2026-07-26') GROUP BY 1) SELECT periods.period, COALESCE(x.value, 0)::DOUBLE AS value FROM periods LEFT JOIN x USING (period)",
