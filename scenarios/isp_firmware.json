      "table": "invoice",
      "per": ["customer"],
      "schedule": {
        "everyDays": 30,
        "phase": "random"
      },
      "fields": {
        "id": {
          "gen": "id"
        },
        "customer_id": {
          "gen": "ref",
          "path": "key.customer"
        },
        "issue_date": {
          "gen": "ref",
          "path": "day"
        },
        "due_days": {
          "gen": "const",
          "value": 14
        },
        "due_date": {
          "gen": "dateOffset",
          "base": "self.issue_date",
          "days": "self.due_days"
        },
        "amount_czk": {
          "gen": "lookup",
          "entity": "customer",
          "key": "key.customer",
          "field": "monthly_fee"
        },
        "status": {
          "gen": "categorical",
          "values": ["zaplaceno", "zaplaceno po splatnosti", "neuhrazeno"],
          "weights": [0.93, 0.05, 0.02]
        }
      }
