  "expectations": [
    {
      "id": "e1",
      "storyPointId": "sp1",
      "description": "Podíl zpožděných zásilek dopravce CAR-002 vzroste nejméně čtyřnásobně",
      "sql": "WITH periods(period) AS (VALUES ('before'), ('after')), x AS (SELECT CASE WHEN d < DATE '2026-04-06' THEN 'before' ELSE 'after' END AS period, AVG(CASE WHEN delay_days > 0 THEN 1.0 ELSE 0.0 END) AS value FROM (SELECT shipped_date AS d, delay_days FROM main.shipment WHERE carrier_id = 'CAR-002') WHERE (d BETWEEN DATE '2026-01-05' AND DATE '2026-04-05' OR d BETWEEN DATE '2026-04-27' AND DATE '2026-07-05') GROUP BY 1) SELECT periods.period, COALESCE(x.value, 0)::DOUBLE AS value FROM periods LEFT JOIN x USING (period)",
      "check": {
        "kind": "increase",
        "minRelChange": 3
      }
    },
