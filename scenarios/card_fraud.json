  "expectations": [
    {
      "id": "e1",
      "storyPointId": "sp1",
      "description": "Podíl zamítnutých plateb vzroste nejméně dvojnásobně",
      "sql": "WITH periods(period) AS (VALUES ('before'), ('after')), x AS (SELECT CASE WHEN d < DATE '2026-08-03' THEN 'before' ELSE 'after' END AS period, AVG(CASE WHEN status = 'zamítnuto' THEN 1.0 ELSE 0.0 END) AS value FROM (SELECT payment_date AS d, status FROM main.card_payment WHERE status IS NOT NULL) WHERE (d BETWEEN DATE '2026-04-13' AND DATE '2026-08-02' OR d BETWEEN DATE '2026-08-10' AND DATE '2026-09-13') GROUP BY 1) SELECT periods.period, COALESCE(x.value, 0)::DOUBLE AS value FROM periods LEFT JOIN x USING (period)",
      "check": {
        "kind": "increase",
        "minRelChange": 1
      }
    },
    {
      "id": "e2",
      "storyPointId": "sp1",
      "description": "Malých online plateb (do 100 Kč) u zahraničních obchodníků přibude nejméně čtyřnásobně",
      "sql": "WITH periods(period) AS (VALUES ('before'), ('after')), x AS (SELECT CASE WHEN d < DATE '2026-08-03' THEN 'before' ELSE 'after' END AS period, COUNT(*) / COUNT(DISTINCT d) AS value FROM (SELECT payment_date AS d FROM main.card_payment WHERE amount_czk < 100 AND merchant_country <> 'CZ') WHERE (d BETWEEN DATE '2026-04-13' AND DATE '2026-08-02' OR d BETWEEN DATE '2026-08-10' AND DATE '2026-09-13') GROUP BY 1) SELECT periods.period, COALESCE(x.value, 0)::DOUBLE AS value FROM periods LEFT JOIN x USING (period)",
      "check": {
        "kind": "increase",
        "minRelChange": 3
      }
    },
    {
      "id": "e3",
      "storyPointId": "sp1",
      "description": "Chargebacků přibude nejméně čtyřnásobně (se zpožděním několika týdnů)",
      "sql": "WITH periods(period) AS (VALUES ('before'), ('after')), x AS (SELECT CASE WHEN d < DATE '2026-08-03' THEN 'before' ELSE 'after' END AS period, COUNT(*) * 1.0 / (CASE WHEN MIN(d) < DATE '2026-08-03' THEN 112 ELSE 42 END) AS value FROM (SELECT opened_date AS d FROM main.chargeback) WHERE (d BETWEEN DATE '2026-04-13' AND DATE '2026-08-02' OR d BETWEEN DATE '2026-08-24' AND DATE '2026-10-04') GROUP BY 1) SELECT periods.period, COALESCE(x.value, 0)::DOUBLE AS value FROM periods LEFT JOIN x USING (period)",
      "check": {
        "kind": "increase",
        "minRelChange": 3
      }
    },
    {
      "id": "e4",
      "storyPointId": "sp1",
      "description": "Hlášení „neznámá platba“ od klientů přibude nejméně trojnásobně",
      "sql": "WITH periods(period) AS (VALUES ('before'), ('after')), x AS (SELECT CASE WHEN d < DATE '2026-08-03' THEN 'before' ELSE 'after' END AS period, COUNT(*) * 1.0 / (CASE WHEN MIN(d) < DATE '2026-08-03' THEN 112 ELSE 35 END) AS value FROM (SELECT reported_date AS d FROM main.client_report WHERE topic = 'neznámá platba') WHERE (d BETWEEN DATE '2026-04-13' AND DATE '2026-08-02' OR d BETWEEN DATE '2026-08-10' AND DATE '2026-09-13') GROUP BY 1) SELECT periods.period, COALESCE(x.value, 0)::DOUBLE AS value FROM periods LEFT JOIN x USING (period)",
      "check": {
