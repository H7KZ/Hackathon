      "sql": "WITH periods(period) AS (VALUES ('before'), ('after')), x AS (SELECT CASE WHEN d < DATE '2026-09-14' THEN 'before' ELSE 'after' END AS period, COUNT(*) * 1.0 / (CASE WHEN MIN(d) < DATE '2026-09-14' THEN 35 ELSE 42 END) AS value FROM (SELECT payment_date AS d FROM main.card_payment WHERE status = 'schváleno' AND device = 'nové zařízení' AND amount_czk > 3000) WHERE (d BETWEEN DATE '2026-08-10' AND DATE '2026-09-13' OR d BETWEEN DATE '2026-09-28' AND DATE '2026-11-08') GROUP BY 1) SELECT periods.period, COALESCE(x.value, 0)::DOUBLE AS value FROM periods LEFT JOIN x USING (period)",
