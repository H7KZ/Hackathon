      "sql": "WITH periods(period) AS (VALUES ('before'), ('after')), x AS (SELECT CASE WHEN d < DATE '2026-08-03' THEN 'before' ELSE 'after' END AS period, COUNT(*) / COUNT(DISTINCT d) AS value FROM (SELECT payment_date AS d FROM main.card_payment WHERE channel = 'terminál') WHERE (d BETWEEN DATE '2026-04-13' AND DATE '2026-08-02' OR d BETWEEN DATE '2026-08-10' AND DATE '2026-09-13') GROUP BY 1) SELECT periods.period, COALESCE(x.value, 0)::DOUBLE AS value FROM periods LEFT JOIN x USING (period)",
