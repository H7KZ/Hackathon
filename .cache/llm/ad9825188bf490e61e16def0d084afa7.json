            ],
            "weights": [
              0.4,
              0.6
            ]
          }
        }
      }
    ],
    "flows": [
      {
        "id": "stock",
        "keys": [
          "product"
        ],
        "initial": {
          "gen": "normal",
          "mean": 50,
          "sd": 8,
          "min": 5,
          "round": true
