        ],
        "rate": {
          "curve": "demand",
          "scale": 0.05
        },
        "fields": {
          "id": {
            "gen": "id"
          },
          "customer_id": {
            "gen": "ref",
            "path": "key.customer"
          },
          "category": {
            "gen": "categorical",
            "values": [
              "sportovní",
              "ostatní"
            ],
            "weights": [
              {
                "curve": "sport_share"
              },
              {
                "curve": "other_share"
              }
            ]
          },
          "product_id": {
            "gen": "pick",
            "entity": "product",
            "where": {
              "category": "self.category"
            }
          },
          "quantity": {
            "gen": "uniformInt",
            "min": 1,
            "max": 1
          },
          "date": {
            "gen": "ref",
            "path": "day"
          }
        },
        "visibility": "ground_truth"
      },
      {
        "type": "branch",
        "id": "activity_check",
        "source": "order_attempt",
        "cond": {
          "kind": "flowGte",
          "flow": "customer_active",
          "keys": {
            "customer": "source.customer_id"
          },
          "value": 1
        },
        "then": {
          "table": "active_attempt",
          "visibility": "ground_truth",
          "fields": {
            "id": {
              "gen": "id"
            },
            "attempt_id": {
              "gen": "ref",
              "path": "source.id"
            },
            "customer_id": {
              "gen": "ref",
              "path": "source.customer_id"
            },
            "product_id": {
              "gen": "ref",
              "path": "source.product_id"
            },
            "category": {
              "gen": "ref",
              "path": "source.category"
            },
            "quantity": {
              "gen": "ref",
              "path": "source.quantity"
            },
            "date": {
              "gen": "ref",
              "path": "day"
            }
          }
        }
      },
      {
        "type": "branch",
        "id": "order_check",
        "source": "activity_check:then",
        "cond": {
          "kind": "flowGte",
          "flow": "stock",
          "keys": {
            "product": "source.product_id"
          },
          "value": "source.quantity"
        },
        "then": {
          "table": "eshop_order",
          "fields": {
            "id": {
              "gen": "id"
            },
            "attempt_id": {
              "gen": "ref",
              "path": "source.attempt_id"
            },
            "customer_id": {
              "gen": "ref",
              "path": "source.customer_id"
            },
            "product_id": {
              "gen": "ref",
              "path": "source.product_id"
            },
            "category": {
              "gen": "ref",
              "path": "source.category"
            },
            "supplier_id": {
              "gen": "lookup",
              "entity": "product",
              "key": "source.product_id",
              "field": "supplier_id"
            },
            "courier_id": {
              "gen": "pick",
              "entity": "courier"
            },
            "quantity": {
              "gen": "ref",
              "path": "source.quantity"
            },
            "unit_price": {
              "gen": "lookup",
              "entity": "product",
              "key": "source.product_id",
              "field": "price"
            },
            "margin_pct": {
              "gen": "lookup",
              "entity": "product",
              "key": "source.product_id",
              "field": "margin_pct"
            },
            "date": {
              "gen": "ref",
              "path": "day"
            },
            "delivery_days": {
              "gen": "uniformInt",
              "min": 1,
              "max": 4
            },
            "delivered_date": {
              "gen": "dateOffset",
              "base": "self.date",
              "days": "self.delivery_days"
            }
          },
          "effects": [
            {
              "flow": "stock",
              "keys": {
                "product": "source.product_id"
              },
              "delta": "self.quantity",
              "sign": -1
            }
          ]
        },
        "else": {
          "table": "lost_sale",
          "fields": {
            "id": {
              "gen": "id"
            },
            "attempt_id": {
              "gen": "ref",
              "path": "source.attempt_id"
            },
            "customer_id": {
              "gen": "ref",
              "path": "source.customer_id"
            },
            "product_id": {
              "gen": "ref",
              "path": "source.product_id"
            },
            "category": {
              "gen": "ref",
              "path": "source.category"
            },
            "quantity": {
              "gen": "ref",
              "path": "source.quantity"
            },
            "date": {
              "gen": "ref",
              "path": "day"
            }
          }
        }
      },
      {
        "type": "arrival",
        "id": "purchase_delivery",
        "table": "purchase_order",
        "per": [
          "product"
        ],
        "schedule": {
          "everyDays": 7,
          "phase": "random"
        },
        "fields": {
          "id": {
            "gen": "id"
          },
          "product_id": {
            "gen": "ref",
            "path": "key.product"
          },
          "supplier_id": {
            "gen": "lookup",
            "entity": "product",
            "key": "key.product",
            "field": "supplier_id"
          },
          "quantity": {
            "gen": "topUp",
            "flow": "stock",
            "keys": {
              "product": "key.product"
            },
            "target": {
              "curve": "stock_target",
              "scale": 60
            }
          },
          "order_date": {
            "gen": "ref",
            "path": "day"
          },
          "lead_days": {
            "gen": "uniformInt",
            "min": 2,
            "max": 5
          },
          "delivered_date": {
            "gen": "dateOffset",
            "base": "self.order_date",
            "days": "self.lead_days"
          }
        },
        "effects": [
          {
            "flow": "stock",
            "keys": {
              "product": "key.product"
            },
            "delta": "self.quantity",
            "sign": 1,
            "on": "self.delivered_date"
          }
        ]
      },
      {
        "type": "branch",
        "id": "defect_check",
        "source": "order_check:then",
        "lag": {
          "min": 7,
          "max": 60
        },
        "cond": {
          "kind": "or",
          "conds": [
            {
              "kind": "and",
              "conds": [
                {
                  "kind": "fieldEq",
                  "path": "source.category",
                  "value": "sportovní"
                },
                {
                  "kind": "bernoulli",
                  "p": {
                    "curve": "defect_prob"
                  }
                }
              ]
            },
            {
              "kind": "and",
              "conds": [
                {
                  "kind": "fieldEq",
                  "path": "source.category",
                  "value": "ostatní"
                },
                {
                  "kind": "bernoulli",
                  "p": 0.02
                }
              ]
            }
          ]
        },
        "then": {
          "table": "complaint",
          "fields": {
            "id": {
              "gen": "id"
            },
            "order_id": {
              "gen": "ref",
              "path": "source.id"
            },
            "customer_id": {
              "gen": "ref",
              "path": "source.customer_id"
            },
            "product_id": {
              "gen": "ref",
              "path": "source.product_id"
            },
            "supplier_id": {
              "gen": "ref",
              "path": "source.supplier_id"
            },
            "category": {
              "gen": "ref",
              "path": "source.category"
            },
            "amount": {
              "gen": "ref",
              "path": "source.unit_price"
            },
            "reason": {
              "gen": "categorical",
              "values": [
                "rozlepená podrážka",
                "špatné šití",
                "špatná velikost",
                "poškození při přepravě",
                "rychlé opotřebení"
              ],
              "weights": [
                0.3,
                0.25,
                0.1,
                0.1,
                0.25
              ]
            },
            "date": {
              "gen": "ref",
              "path": "day"
            }
          }
        }
      },
      {
        "type": "derive",
        "id": "return_flow",
        "table": "return_request",
        "source": "defect_check:then",
        "p": 0.6,
        "lag": {
          "min": 1,
          "max": 7
        },
        "fields": {
          "id": {
            "gen": "id"
          },
          "complaint_id": {
            "gen": "ref",
            "path": "source.id"
          },
          "customer_id": {
            "gen": "ref",
            "path": "source.customer_id"
          },
          "refund_amount": {
            "gen": "ref",
            "path": "source.amount"
          },
          "date": {
            "gen": "ref",
            "path": "day"
          }
        }
