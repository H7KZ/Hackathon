      {
        "type": "derive",
        "id": "churn_flow",
        "table": "customer_churn",
        "source": "defect_check:then",
        "p": {
          "curve": "churn_after_complaint"
        },
        "lag": {
          "min": 5,
          "max": 30
        },
        "fields": {
          "id": {
            "gen": "id"
          },
          "customer_id": {
            "gen": "ref",
            "path": "source.customer_id"
          },
          "complaint_id": {
            "gen": "ref",
            "path": "source.id"
          },
          "reason": {
            "gen": "const",
            "value": "opakované reklamace kvality"
          },
          "churned": {
            "gen": "const",
            "value": 1
          },
          "date": {
            "gen": "ref",
            "path": "day"
          }
        },
        "effects": [
          {
            "flow": "customer_active",
            "keys": {
              "customer": "self.customer_id"
            },
            "delta": "self.churned",
            "sign": -1
          }
        ]
