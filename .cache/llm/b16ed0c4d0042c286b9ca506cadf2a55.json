              "gen": "id"
            },
            "purchase_order_id": {
              "gen": "ref",
              "path": "source.id"
            },
            "product_id": {
              "gen": "ref",
              "path": "source.product_id"
            },
            "supplier_tier": {
              "gen": "ref",
              "path": "source.supplier_tier"
