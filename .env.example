# LLM (all calls go through @s2d/llm with disk cache)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# provider:model, e.g. anthropic:claude-sonnet-5-5 or openai:gpt-5
GROQ_API_KEY=

LLM_MODEL=anthropic:claude-sonnet-5-5
LLM_MODEL_01_COMPANY=anthropic:claude-haiku-5-5
LLM_MODEL_03_INFLUENCES=anthropic:claude-haiku-5-5

# 1 = never call the network; cache miss is an error (demo mode)
LLM_OFFLINE=0

# API
API_PORT=4000
# frontend -> api
API_URL=http://localhost:4000