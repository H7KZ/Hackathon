{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "vitest.shared.ts",
    "vitest.config.ts",
    ".dependency-cruiser.cjs"
  ],
  "globalPassThroughEnv": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY", "LLM_MODEL", "API_PORT", "CORS_ORIGIN"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["transit"],
      "env": ["NEXT_PUBLIC_API_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "env": ["LLM_OFFLINE", "EVAL_LIVE"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "env": ["LLM_OFFLINE"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
